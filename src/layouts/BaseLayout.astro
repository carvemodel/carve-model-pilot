---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/" or "/about-carve-model" — combined with the site's canonical domain */
  canonicalPath: string;
  ogType?: 'website' | 'article';
  ogTitle?: string;
  ogDescription?: string;
  /** Absolute URL. Defaults to the site's fallback social-share image if not set (e.g. for a blog post's featured photo). */
  ogImage?: string;
  robotsNoIndex?: boolean;
  /** Which primary-nav item is active, for aria-current="page" */
  active?: 'services' | 'process' | 'works' | 'about' | 'blog' | 'faq' | 'contact';
  /** Whether this page loads image-slot.js (some source pages use <image-slot> without it — preserved as-is) */
  imageSlot?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  ogType = 'website',
  ogTitle,
  ogDescription,
  ogImage = 'https://www.physical-model.com/assets/og-home.jpg',
  robotsNoIndex = false,
  active,
  imageSlot = false,
} = Astro.props;

const SITE = 'https://www.physical-model.com';
const canonical = SITE + (canonicalPath === '/' ? '/' : canonicalPath);
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
{robotsNoIndex && <meta name="robots" content="noindex,nofollow">}
<link rel="canonical" href={canonical}>
<meta property="og:type" content={ogType}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<link rel="icon" type="image/png" href="/assets/logo-mark.png">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles.css">

<!-- GA4 + Google Ads account-level tag. One GA4 property (G-GWS8BLWWST), one
     gtag implementation, loaded once here site-wide (never duplicated per
     page). Gated to the real production domain(s) so localhost, Vercel
     preview URLs, and any other pre-launch/QA host never send hits to the
     live GA4 property or Google Ads conversions -- update PROD_HOSTS when
     the physical-model.com domain cutover goes live (see
     MIGRATION_SEPTEMBER_2.md). The contact_form conversion fire itself
     (AW-16810390124/4mVjCKWR6ucaEOzk6M8-) lives in contact.astro/thank-you.astro;
     the click-to-call GA4 event fires below and is ready to carry a second
     Ads conversion label once one exists. -->
<script is:inline>
  (function(){
    var PROD_HOSTS = ['physical-model.com', 'www.physical-model.com'];
    window.__CM_ANALYTICS_ENABLED__ = PROD_HOSTS.indexOf(window.location.hostname) !== -1;
  })();
</script>
<script async src="https://www.googletagmanager.com/gtag/js?id=G-GWS8BLWWST"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){ dataLayer.push(arguments); }
  if (window.__CM_ANALYTICS_ENABLED__) {
    gtag('js', new Date());
    gtag('config', 'G-GWS8BLWWST');
    gtag('config', 'AW-16810390124');
  }
</script>

<!-- Click-to-call tracking (secondary conversion per the tracking spec).
     Fires a GA4 event for every tel: link on the site (footer + contact
     page) via delegation, so it works regardless of when/where the link
     is added. Gated by the same production-only flag above. -->
<script is:inline>
  document.addEventListener('click', function(e){
    var link = e.target.closest && e.target.closest('a[href^="tel:"]');
    if (!link) return;
    if (!window.__CM_ANALYTICS_ENABLED__ || typeof gtag !== 'function') return;
    gtag('event', 'click_to_call', {
      phone_number: link.getAttribute('href').replace('tel:', ''),
      page_path: window.location.pathname
    });
    // "Website Click to Call" Google Ads conversion action (Contacts goal,
    // secondary action, source: Website, manual event) -- fires alongside
    // the GA4 event above so click-to-call reports as the secondary Ads
    // conversion while Submit Lead Form remains the only primary one.
    gtag('event', 'conversion', {
      send_to: 'AW-16810390124/geEzCNOR-9AbEOzk6M8-'
    });
  });
</script>

<!-- First-touch attribution capture (site-wide, runs on every page). Only
     writes once per browser session, so whichever page a visitor actually
     lands on first — via a paid ad, an organic search result, a bookmark,
     etc. — is what gets recorded, not whatever page they happen to be on
     when they eventually reach the contact form. contact.astro reads this
     back out of sessionStorage and attaches it to the lead it submits. -->
<script is:inline>
(function(){
  try{
    var KEY='cm_attribution';
    if(sessionStorage.getItem(KEY))return;
    var p=new URLSearchParams(location.search);
    sessionStorage.setItem(KEY, JSON.stringify({
      gclid: p.get('gclid') || '',
      utmSource: p.get('utm_source') || '',
      utmMedium: p.get('utm_medium') || '',
      utmCampaign: p.get('utm_campaign') || '',
      landingPage: location.href,
      referrer: document.referrer || ''
    }));
  }catch(e){}
})();
</script>

<!-- Basic deterrent against casual photo downloading: blocks the
     right-click "Save image as..." menu and drag-out-of-browser on <img>
     elements site-wide. This can't stop a determined visitor (screenshots
     always work, and browser dev tools can inspect any image URL), but it
     removes the two most common casual paths to grabbing a full-res copy
     of a portfolio photo without disrupting normal browsing -- text
     selection, links, and buttons are untouched, and this only ever fires
     on real <img> tags, not the CSS background-image plates used
     elsewhere on the site. -->
<script is:inline>
  document.addEventListener('contextmenu', function(e){
    if (e.target && e.target.tagName === 'IMG') e.preventDefault();
  });
  document.addEventListener('dragstart', function(e){
    if (e.target && e.target.tagName === 'IMG') e.preventDefault();
  });
</script>

<slot name="head" />
</head>
<body>
<Header active={active} />
<slot />
<Footer />
{imageSlot && <script src="/image-slot.js" is:inline></script>}
<script src="/site.js" is:inline></script>
<slot name="scripts" />
</body>
</html>
