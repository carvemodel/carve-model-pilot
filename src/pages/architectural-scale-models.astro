---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Architectural & Real Estate Models | Carve Model"
  description="Architectural and real estate scale models for planning approvals, sales galleries, investor presentations, and design reviews — massing, presentation, and site models built in-house."
  canonicalPath="/architectural-scale-models"
  ogTitle="Architectural & Real Estate Models | Carve Model"
  ogDescription="Architectural and real estate scale models for planning approvals, sales galleries, investor presentations, and design reviews — massing, presentation, and site models built in-house."
  active="services"
  imageSlot={true}
>
<Fragment slot="head">
<script type="application/ld+json" is:inline set:html={`{"@context":"https://schema.org","@type":"Service","@id":"https://www.physical-model.com/architectural-scale-models#service","url":"https://www.physical-model.com/architectural-scale-models","name":"Architectural & Real Estate Models","serviceType":"Architectural & Real Estate Models","provider":{"@id":"https://www.physical-model.com/#organization"},"areaServed":[{"@type":"Country","name":"United States"},{"@type":"Country","name":"Canada"}]}`} />
<script type="application/ld+json" is:inline set:html={`{"@context":"https://schema.org","@type":"BreadcrumbList","@id":"https://www.physical-model.com/architectural-scale-models#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.physical-model.com/"},{"@type":"ListItem","position":2,"name":"Services","item":"https://www.physical-model.com/scale-model-services"},{"@type":"ListItem","position":3,"name":"Architectural & Real Estate Models","item":"https://www.physical-model.com/architectural-scale-models"}]}`} />
<style>
.breadcrumb{padding-top:1.6rem;}
.breadcrumb a{font-family:var(--font-mono);font-size:0.78rem;letter-spacing:0.04em;color:var(--cm-text-subtle);transition:color var(--dur-2);}
.breadcrumb a:hover{color:var(--cm-text-strong);}
.page-hero{padding-top:1.6rem;padding-bottom:clamp(2.5rem,4vw,4rem);border-bottom:1px solid var(--cm-line-faint);}
.page-hero h1{margin-top:1.4rem;}
.page-hero h1 em{font-style:normal;color:var(--cm-text-muted);}
.page-hero p{margin-top:1.4rem;}
.page-hero__inner{display:grid;grid-template-columns:0.85fr 1.15fr;gap:clamp(1.5rem,3vw,3rem);align-items:center;}
@media(max-width:900px){.page-hero__inner{grid-template-columns:1fr;}.page-hero__visual{order:-1;max-width:440px;}}
.page-hero__visual{position:relative;}
.page-hero__visual image-slot{width:100%;height:auto;aspect-ratio:4/3;border-radius:var(--r-sm);}
.page-hero__visual .corner{position:absolute;width:14px;height:14px;border:1px solid var(--cm-silver);opacity:0.5;z-index:3;}
.page-hero__visual .corner.tl{top:-1px;left:-1px;border-right:0;border-bottom:0;}
.page-hero__visual .corner.br{bottom:-1px;right:-1px;border-left:0;border-top:0;}
.hero__spec{position:absolute;right:-12px;bottom:24px;z-index:4;background:var(--cm-ink-800);border:1px solid var(--cm-border-strong);padding:0.9rem 1.1rem;box-shadow:var(--shadow-lg);}
.hero__spec .tick{display:block;}
.hero__spec strong{font-family:var(--font-display);font-weight:var(--w-bold);color:var(--cm-text-strong);font-size:1.1rem;letter-spacing:-0.01em;}
.hero__cta{display:flex;gap:0.9rem;flex-wrap:nowrap;margin-top:1.8rem;}
@media(max-width:560px){.hero__cta{flex-wrap:wrap;}}
.hero__cta .btn--primary,.hero__cta .btn--ghost{background:transparent;color:var(--cm-text-strong);border:1px solid var(--cm-border-strong);}
.hero__cta .btn--primary:hover,.hero__cta .btn--ghost:hover{background:var(--cm-accent);color:var(--cm-accent-contrast);border-color:var(--cm-accent);}
.svc-all-btn{background:transparent;color:var(--cm-text-strong);}
.svc-all-btn:hover{background:var(--cm-accent);color:var(--cm-accent-contrast);border-color:var(--cm-accent);}
.dedi-media{margin-top:clamp(2rem,4vw,3rem);}
.dedi-media image-slot{width:100%;height:auto;aspect-ratio:21/9;}
.dedi-body{padding-block:clamp(3rem,5vw,5rem);}
.dedi-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,4vw,4rem);align-items:start;}
.dedi-grid h2{font-size:clamp(1.6rem,2.6vw,2.1rem);letter-spacing:-0.02em;}
.dedi-list{list-style:none;padding:0;margin:1.4rem 0 0;display:grid;gap:0.8rem;}
.dedi-list li{display:flex;gap:0.7rem;align-items:flex-start;font-size:0.98rem;color:var(--cm-text-muted);}
.dedi-list li svg{flex:none;margin-top:4px;color:var(--cm-silver);}
@media(max-width:820px){.dedi-grid{grid-template-columns:1fr;}}
.svc-section{padding-block:clamp(3rem,5vw,5rem);border-bottom:1px solid var(--cm-line-faint);}
.svc-section h2{font-size:clamp(1.6rem,2.8vw,2.3rem);letter-spacing:-0.02em;margin-top:1rem;}
.svc-section .lead-p{margin-top:1.2rem;max-width:68ch;}
.svc-checklist{list-style:none;padding:0;margin:1.8rem 0 0;display:grid;gap:0.75rem;max-width:68ch;}
.svc-checklist li{display:flex;gap:0.7rem;align-items:flex-start;font-size:0.98rem;color:var(--cm-text-muted);}
.svc-checklist li svg{flex:none;margin-top:4px;color:var(--cm-silver);}
.svc-types{display:grid;grid-template-columns:repeat(2,1fr);gap:clamp(1.6rem,3vw,2.6rem);margin-top:2rem;}
.svc-type{padding-top:0;border-top:0;}
.svc-type__media{margin-bottom:0.9rem;}
.svc-type__media image-slot{width:100%;height:auto;aspect-ratio:4/3;border-radius:var(--r-sm);}
.svc-type h3{font-size:1.1rem;font-weight:var(--w-semibold);color:var(--cm-text-strong);letter-spacing:-0.01em;}
.svc-type p{margin-top:0.5rem;color:var(--cm-text-muted);font-size:0.92rem;max-width:none;}
@media(max-width:760px){.svc-types{grid-template-columns:1fr;}}
.svc-steps{display:grid;gap:0;margin-top:2rem;max-width:68ch;}
.svc-step{display:grid;grid-template-columns:2.4rem 1fr;gap:1rem;padding-block:1rem;border-bottom:1px solid var(--cm-line-faint);}
.svc-step:last-child{border-bottom:0;}
.svc-step__n{font-family:var(--font-mono);font-size:0.85rem;color:var(--cm-text-subtle);padding-top:0.15rem;}
.svc-step p{color:var(--cm-text-muted);font-size:0.95rem;}
.svc-note{margin-top:1.4rem;color:var(--cm-text-muted);max-width:68ch;}
.formats{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--cm-line-faint);border:1px solid var(--cm-line-faint);margin-top:1.8rem;}
.fmt{position:relative;background:var(--cm-ink-900);padding:1.4rem 1rem;text-align:center;font-family:var(--font-mono);font-size:0.8rem;color:var(--cm-gray-300);letter-spacing:0.03em;transition:background var(--dur-3),color var(--dur-3);}
.fmt:hover{background:var(--cm-ink-850);color:var(--cm-text-strong);}
@media(max-width:760px){.formats{grid-template-columns:repeat(2,1fr);}}
@media(max-width:480px){.formats{grid-template-columns:1fr;}}
.svc-split{display:grid;grid-template-columns:1.1fr 0.9fr;gap:clamp(2rem,4vw,4rem);align-items:start;}
.svc-split .svc-checklist,.svc-split .lead-p{max-width:none;}
.svc-split__media image-slot{width:100%;height:auto;aspect-ratio:4/5;border-radius:var(--r-sm);}
@media(max-width:900px){.svc-split{grid-template-columns:1fr;}.svc-split__media{order:-1;max-width:440px;}}
</style>
</Fragment>

<main>
<div class="container breadcrumb"><a href="/scale-model-services">← All services</a></div>

<section class="page-hero"><div class="container">
  <div class="page-hero__inner">
    <div>
      <span class="eyebrow">Services / Architecture &amp; Real Estate</span>
      <h1 class="display-lg measure">Architectural <em>models</em><br>built for<br>confident <em>decisions</em>.</h1>
      <p class="lead measure">Carve Model creates architectural models for design reviews, approvals, presentations, and sales galleries—developed around what each audience needs to understand.</p>
      <div class="hero__cta">
        <a class="btn btn--primary btn--lg" href="/contact">Get a Preliminary Estimate <span class="arrow">→</span></a>
        <a class="btn btn--ghost btn--lg" href="/works">View Architectural Work <span class="arrow">→</span></a>
      </div>
    </div>
    <div class="page-hero__visual reveal">
      <span class="corner tl"></span><span class="corner br"></span>
      <image-slot id="svc-arch-hero" placeholder="Drop architectural model photo" src="/assets/service-architecture-hero.webp"></image-slot>
      <span class="slot-label">Residential Villa · 1:50 · ABS</span>
      <div class="hero__spec">
        <span class="tick">PROJECTS DELIVERED</span>
        <strong>500+ models</strong>
      </div>
    </div>
  </div>
</div></section>

<section class="svc-section"><div class="container">
  <span class="eyebrow">What architectural models support</span>
  <h2>Bring the complete project into view.</h2>
  <div class="svc-split" style="margin-top:1.2rem;">
    <div>
      <p class="lead-p muted" style="margin-top:0;">Drawings, renderings, BIM, animation, and virtual environments communicate different aspects of a design. A physical model brings the project's scale, form, context, and spatial relationships into one tangible object that people can examine together.</p>
      <p class="muted" style="margin-top:1rem;">Depending on the project, an architectural model can help teams:</p>
      <ul class="svc-checklist">
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Evaluate massing, height, density, and proportion</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Understand site, landscape, and urban relationships</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Review circulation, access, and public space</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Communicate with technical and nontechnical audiences</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Support planning and government approvals</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Present projects to investors and stakeholders</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Create a focal point for a sales gallery or exhibition</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Document a completed or existing development</li>
      </ul>
    </div>
    <div class="svc-split__media"><image-slot id="svc-arch-support" placeholder="Drop a project photo" src="/assets/svc-arch-support.webp"></image-slot></div>
  </div>
</div></section>

<section class="svc-section"><div class="container">
  <div class="flex justify-between items-center wrap gap">
    <div>
      <span class="eyebrow">Model types</span>
      <h2>Architectural models for every project stage.</h2>
    </div>
    <a class="btn btn--ghost svc-all-btn" href="/works">View Our Work <span class="arrow">→</span></a>
  </div>
  <div class="svc-types">
    <div class="svc-type"><div class="svc-type__media"><image-slot id="svc-type-concept" placeholder="Drop concept/massing model photo" src="/assets/type-concept.webp"></image-slot></div><h3>Concept and massing models</h3><p>Simplified physical studies of volume, height, proportion, circulation, and site relationships. Used for early design evaluation, planning discussions, and stakeholder communication.</p></div>
    <div class="svc-type"><div class="svc-type__media"><image-slot id="svc-type-planning" placeholder="Drop planning/design-review model photo" src="/assets/type-planning.webp"></image-slot></div><h3>Planning and design-review models</h3><p>Models developed to communicate setbacks, density, context, landscape, public space, access, and relationships to surrounding buildings.</p></div>
    <div class="svc-type"><div class="svc-type__media"><image-slot id="svc-type-masterplan" placeholder="Drop masterplan/urban model photo" src="/assets/type-masterplan-v2.webp"></image-slot></div><h3>Masterplan and urban-planning models</h3><p>Large-area models representing multiple buildings, streets, infrastructure, landscape, development phases, and wider urban context.</p></div>
    <div class="svc-type"><div class="svc-type__media"><image-slot id="svc-type-presentation" placeholder="Drop presentation/sales-gallery model photo" src="/assets/type-presentation.webp"></image-slot></div><h3>Presentation and sales-gallery models</h3><p>Detailed architectural models with developed façades, glazing, landscaping, lighting, materials, and refined finishes for investors, buyers, exhibitions, and marketing environments.</p></div>
    <div class="svc-type"><div class="svc-type__media"><image-slot id="svc-type-topo" placeholder="Drop topographic/site model photo" src="/assets/type-topo.webp"></image-slot></div><h3>Topographic and site models</h3><p>Models showing contours, terrain, roads, water, vegetation, infrastructure, site boundaries, and the relationship between a development and its setting.</p></div>
    <div class="svc-type"><div class="svc-type__media"><image-slot id="svc-type-interior" placeholder="Drop interior/section model photo" src="/assets/type-interior.webp"></image-slot></div><h3>Interior and section models</h3><p>Larger-scale models used to communicate rooms, units, floors, circulation, structure, ceiling heights, furniture, finishes, and relationships that would otherwise remain hidden inside the building.</p></div>
    <div class="svc-type"><div class="svc-type__media"><image-slot id="svc-type-coordination" placeholder="Drop coordination/construction model photo" src="/assets/type-construction.webp"></image-slot></div><h3>Coordination and construction models</h3><p>Models focused on important assemblies, construction sequences, site logistics, access conditions, or technically complex relationships.</p></div>
    <div class="svc-type"><div class="svc-type__media"><image-slot id="svc-type-asbuilt" placeholder="Drop existing-condition/as-built model photo" src="/assets/type-asbuilt.webp"></image-slot></div><h3>Existing-condition and as-built models</h3><p>Physical records of completed buildings, sites, facilities, and infrastructure for presentation, renovation planning, exhibitions, fundraising, or long-term documentation.</p></div>
  </div>
</div></section>

<section class="svc-section"><div class="container">
  <span class="eyebrow">Defining the model</span>
  <h2>Purpose determines scale and detail.</h2>
  <div class="svc-split" style="margin-top:1.2rem;">
    <div>
      <p class="lead-p muted" style="margin-top:0;">The most effective architectural model is not necessarily the largest or most detailed. Its scale, boundaries, content, and finish should reflect what the audience needs to understand.</p>
      <p class="muted" style="margin-top:1rem;">Before fabrication, we define:</p>
      <ul class="svc-checklist">
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Intended audience and use</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Decision or presentation the model must support</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Building and site boundaries</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Scale or desired model dimensions</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Required architectural and landscape detail</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Materials, colors, and finishes</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Lighting and functional features</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Base, stand, and display-case requirements</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Transportation, access, and installation constraints</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Schedule and delivery location</li>
      </ul>
    </div>
    <div class="svc-split__media"><image-slot id="svc-arch-defining" placeholder="Drop a project photo" src="/assets/svc-arch-defining.webp"></image-slot></div>
  </div>
</div></section>

<section class="svc-section"><div class="container">
  <span class="eyebrow">Start with what you have</span>
  <h2>Complete production files are not required for an initial review.</h2>
  <p class="muted" style="margin-top:1rem;">We can review:</p>
  <div class="formats">
    <div class="fmt">CAD and DWG files</div>
    <div class="fmt">Revit and BIM files</div>
    <div class="fmt">Rhino and SketchUp models</div>
    <div class="fmt">STL and OBJ files</div>
    <div class="fmt">PDFs and dimensioned drawings</div>
    <div class="fmt">Plans, elevations, and sections</div>
    <div class="fmt">Renderings and photographs</div>
    <div class="fmt">Sketches and concept drawings</div>
    <div class="fmt">AI-generated reference images</div>
  </div>
  <p class="svc-note" style="max-width:none;">* When usable geometry is available, we prepare it for physical fabrication. When production-ready geometry does not exist, Digital Model Development may be separately scoped.</p>
</div></section>

<section class="svc-section"><div class="container">
  <div class="flex justify-between items-center wrap gap">
    <div>
      <span class="eyebrow">Features and support</span>
      <h2>One coordinated physical deliverable.</h2>
    </div>
    <a class="btn btn--ghost svc-all-btn" href="/scale-model-services">Explore Our Services <span class="arrow">→</span></a>
  </div>
  <div class="svc-split" style="grid-template-columns:0.9fr 1.1fr;margin-top:1.6rem;">
    <div class="svc-split__media"><image-slot id="svc-arch-features" placeholder="Drop a project photo" src="/assets/svc-arch-features.webp"></image-slot></div>
    <div>
      <p class="muted">Depending on the project, Carve can coordinate:</p>
      <ul class="svc-checklist">
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Integrated architectural and landscape lighting</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Removable or interchangeable sections</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Custom bases and stands</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Protective covers and display cases</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Material and finish samples</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Sectional construction for transportation</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Protective packaging and shipping</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> On-site assembly and installation</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Complementary animation, AR, or VR deliverables when appropriate</li>
      </ul>
      <p class="svc-note">Complementary digital deliverables are separately scoped according to the audience, source information, platform, and project requirements.</p>
    </div>
  </div>
</div></section>

<section class="svc-section" style="border-bottom:0;"><div class="container">
  <div class="flex justify-between items-center wrap gap">
    <div>
      <span class="eyebrow">How it works</span>
      <h2>From project definition to delivery.</h2>
    </div>
    <a class="btn btn--ghost svc-all-btn" href="/model-making-process">View Our Process <span class="arrow">→</span></a>
  </div>
  <div class="svc-steps">
    <div class="svc-step"><span class="svc-step__n">01</span><p>Goal and audience</p></div>
    <div class="svc-step"><span class="svc-step__n">02</span><p>Scope and physical constraints</p></div>
    <div class="svc-step"><span class="svc-step__n">03</span><p>Digital preparation</p></div>
    <div class="svc-step"><span class="svc-step__n">04</span><p>Samples, mockups, and approvals when required</p></div>
    <div class="svc-step"><span class="svc-step__n">05</span><p>Fabrication and assembly</p></div>
    <div class="svc-step"><span class="svc-step__n">06</span><p>Finishing and quality control</p></div>
    <div class="svc-step"><span class="svc-step__n">07</span><p>Packaging, delivery, and setup</p></div>
  </div>
</div></section>

<section class="section"><div class="container">
