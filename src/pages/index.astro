    </div>
    <div class="works-grid">
      {latestWorks.map((w, i) => {
        // The first tile spans 2 grid rows (CSS nth-child(1) rule) and fills
        // that taller cell via aspect-ratio:auto;height:100% — skip the
        // inline aspect-ratio there so it doesn't override that CSS.
        const ratio = w.imageWidth && w.imageHeight ? `${w.imageWidth}/${w.imageHeight}` : '1/1';
        const ratioStyle = i === 0 ? '' : `aspect-ratio:${ratio};`;
        const tick = [w.scale, w.material].filter(Boolean).join(' · ');
        return (
          <figure class="work reveal" data-delay={i === 0 ? undefined : i * 40} style="margin:0;">
            {w.imageUrl
              ? <a href="/works" aria-label={`View ${w.name} on the works page`}><img src={w.imageUrl} alt={w.name} style={ratioStyle} loading="lazy" /></a>
              : <image-slot id={w.id} placeholder="Drop project photo" style={ratioStyle}></image-slot>}
            <figcaption class="work__cap"><h4>{w.name}</h4><span class="tick">{tick}</span></figcaption>
          </figure>
        );
      })}
    </div>
  </div>
</section>

