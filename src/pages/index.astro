---
import BaseLayout from '../layouts/BaseLayout.astro';
import { createClient } from 'redis';

// Shown on the homepage's "Selected work" tiles until real projects exist —
// same data shape as works.astro (id, name, scale, material, imageUrl,
// imageWidth, imageHeight) so the two pages can share the same Redis source.
const FALLBACK_HOME_WORKS = [
  { id: 'hw1', name: 'Mixed-use Tower', scale: '1:144', material: 'ABS', imageUrl: '', imageWidth: 1, imageHeight: 1 },
  { id: 'hw2', name: 'Masterplan', scale: '1:500', material: 'ABS', imageUrl: '', imageWidth: 1, imageHeight: 1 },
  { id: 'hw3', name: 'Sales Gallery', scale: '1:50', material: 'ABS', imageUrl: '', imageWidth: 1, imageHeight: 1 },
  { id: 'hw4', name: 'Product Mockup', scale: '1:1', material: 'Resin', imageUrl: '', imageWidth: 1, imageHeight: 1 },
  { id: 'hw5', name: 'Film Miniature', scale: 'Film-grade', material: 'Foam & wood', imageUrl: '', imageWidth: 1, imageHeight: 1 },
];

// Pulls the same Redis-backed project list used on /works, at build time.
// Shows the 5 most recently added projects (admin-works.html appends new
// entries to the end of the array), newest first. Falls back to sample
// tiles if REDIS_URL is missing or the fetch fails, so the build never breaks.
let latestWorks = FALLBACK_HOME_WORKS;
if (process.env.REDIS_URL) {
  try {
    const client = createClient({ url: process.env.REDIS_URL });
    await client.connect();
    const raw = await client.get('carve:works');
    await client.disconnect();
    if (raw) {
      const data = JSON.parse(raw);
      if (Array.isArray(data.projects) && data.projects.length) {
        latestWorks = data.projects.slice(-5).reverse();
      }
    }
  } catch (err) {
    console.warn('index.astro: could not load projects from Redis, using fallback data.', err);
  }
}
