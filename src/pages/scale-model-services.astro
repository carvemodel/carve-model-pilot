---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Physical Model Making Services | Carve Model"
  description="Carve Model creates architectural models, product prototypes, film miniatures, and art maquettes for presentation, evaluation, testing, and physical verification."
  canonicalPath="/scale-model-services"
  ogTitle="Physical Model Making Services | Carve Model"
  ogDescription="Carve Model creates architectural models, product prototypes, film miniatures, and art maquettes for presentation, evaluation, testing, and physical verification."
  active="services"
  imageSlot={true}
>
<Fragment slot="head">
<script type="application/ld+json" is:inline set:html={`{"@context":"https://schema.org","@type":"Service","@id":"https://www.physical-model.com/scale-model-services#service","url":"https://www.physical-model.com/scale-model-services","serviceType":"Physical model making","provider":{"@id":"https://www.physical-model.com/#organization"},"areaServed":[{"@type":"Country","name":"United States"},{"@type":"Country","name":"Canada"}],"hasOfferCatalog":{"@type":"OfferCatalog","name":"Model making services","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"Architectural & Real Estate Models"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Product Prototypes & Mockups"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Film & Commercial Miniatures"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Art Maquettes & Prototypes"}}]}}`} />
<style>
.page-hero{padding-top:clamp(3rem,6vw,5rem);padding-bottom:clamp(2.5rem,4vw,4rem);border-bottom:1px solid var(--cm-line-faint);}
.page-hero h1{margin-top:1.4rem;}
.page-hero h1 em{font-style:normal;color:var(--cm-text-muted);}
.page-hero__inner{display:grid;grid-template-columns:0.85fr 1.15fr;gap:clamp(1.5rem,3vw,3rem);align-items:center;}
@media(max-width:900px){.page-hero__inner{grid-template-columns:1fr;}.page-hero__visual{order:-1;max-width:440px;}}
.page-hero__visual{position:relative;}
.page-hero__visual .hero-photo{display:block;width:100%;height:auto;aspect-ratio:4/3;border-radius:var(--r-sm);object-fit:cover;object-position:50% center;}
.page-hero__visual .corner{position:absolute;width:14px;height:14px;border:1px solid var(--cm-silver);opacity:0.5;z-index:3;}
.page-hero__visual .corner.tl{top:-1px;left:-1px;border-right:0;border-bottom:0;}
.page-hero__visual .corner.br{bottom:-1px;right:-1px;border-left:0;border-top:0;}
.hero__spec{position:absolute;right:-12px;bottom:24px;z-index:4;background:var(--cm-ink-800);border:1px solid var(--cm-border-strong);padding:0.9rem 1.1rem;box-shadow:var(--shadow-lg);}
.hero__spec .tick{display:block;}
.hero__spec strong{font-family:var(--font-display);font-weight:var(--w-bold);color:var(--cm-text-strong);font-size:1.1rem;letter-spacing:-0.01em;}
.page-hero p{margin-top:1.4rem;}
.hero__cta{display:flex;gap:0.9rem;flex-wrap:nowrap;margin-top:1.8rem;}
@media(max-width:560px){.hero__cta{flex-wrap:wrap;}}
.hero__cta .btn--primary,.hero__cta .btn--ghost{background:transparent;color:var(--cm-text-strong);border:1px solid var(--cm-border-strong);}
.hero__cta .btn--primary:hover,.hero__cta .btn--ghost:hover{background:var(--cm-accent);color:var(--cm-accent-contrast);border-color:var(--cm-accent);}
.svc-block{display:grid;grid-template-columns:0.72fr 1.28fr;gap:clamp(2rem,4vw,4rem);align-items:center;padding-block:clamp(3rem,5vw,5rem);border-bottom:1px solid var(--cm-line-faint);}
.svc-block:nth-child(even){grid-template-columns:1.28fr 0.72fr;}
.svc-block:nth-child(even) .svc-block__media{order:-1;}
.svc-block__media image-slot{width:100%;height:auto;aspect-ratio:16/9;}
.svc-block h2{font-size:clamp(1.8rem,3vw,2.6rem);letter-spacing:-0.02em;margin-top:1.1rem;}
.svc-block p{margin-top:1.1rem;color:var(--cm-gray-300);}
.svc-explore{display:inline-flex;align-items:center;gap:0.5rem;margin-top:1.2rem;font-family:var(--font-mono);font-size:0.82rem;letter-spacing:0.03em;color:var(--cm-text-strong);border-bottom:1px solid var(--cm-border-strong);padding-bottom:2px;transition:border-color var(--dur-2),color var(--dur-2);}
.svc-explore:hover{color:var(--cm-accent);border-color:var(--cm-accent);}
.svc-explore .arrow{transition:transform var(--dur-2);}
.svc-explore:hover .arrow{transform:translateX(4px);}
.svc-block ul{list-style:none;padding:0;margin:1.6rem 0 0;display:grid;gap:0.7rem;}
.svc-block li{display:flex;gap:0.7rem;align-items:flex-start;font-size:0.95rem;color:var(--cm-text-muted);}
.svc-block li svg{flex:none;margin-top:4px;color:var(--cm-silver);}
@media(max-width:900px){.svc-block,.svc-block:nth-child(even){grid-template-columns:1fr;}.svc-block:nth-child(even) .svc-block__media{order:0;}}
.dr-grid{display:grid;grid-template-columns:1fr 1.05fr;gap:clamp(2rem,4vw,4rem);align-items:start;margin-top:1.5rem;}
@media(max-width:820px){.dr-grid{grid-template-columns:1fr;}}
.markets-line{white-space:nowrap;}
@media(max-width:640px){.markets-line{white-space:normal;}}
.workflow{display:flex;flex-direction:column;align-items:stretch;}
.wf-branch{display:grid;grid-template-columns:1fr 1fr;column-gap:0.6rem;align-items:start;margin-bottom:0.5rem;}
.wf-path{display:flex;flex-direction:column;align-items:stretch;border-radius:var(--r-sm);transition:background var(--dur-3);}
.wf-path:hover{background:color-mix(in srgb,var(--cm-accent) 6%,transparent);}
.wf-path__label{font-family:var(--font-mono);font-size:0.68rem;font-weight:var(--w-medium);letter-spacing:0.06em;text-transform:uppercase;color:var(--cm-text-subtle);text-align:center;margin-bottom:0.4rem;transition:color var(--dur-3);}
.workflow:has(.wf-path--left:hover) .wf-path--left .wf-path__label,
.workflow:has(.wf-path--right:hover) .wf-path--right .wf-path__label{color:var(--cm-accent);}
.workflow:has(.wf-path--left:hover) .wf-path--left .workflow__step,
.workflow:has(.wf-path--left:hover) > .workflow__step,
.workflow:has(.wf-path--right:hover) .wf-path--right .workflow__step,
.workflow:has(.wf-path--right:hover) > .workflow__step{border-color:var(--cm-accent);background:var(--cm-ink-850);}
.workflow:has(.wf-path--left:hover) .wf-path--left .workflow__arrow,
.workflow:has(.wf-path--left:hover) > .workflow__arrow,
.workflow:has(.wf-path--right:hover) .wf-path--right .workflow__arrow,
.workflow:has(.wf-path--right:hover) > .workflow__arrow{color:var(--cm-accent);}
.workflow__step{width:100%;text-align:center;background:var(--cm-ink-900);border:1px solid var(--cm-border);border-radius:var(--r-sm);padding:1.1rem 1.3rem;transition:border-color var(--dur-3),background var(--dur-3);}
.workflow__step:hover{background:var(--cm-ink-850);border-color:var(--cm-accent);}
.workflow__step h4{font-family:var(--font-mono);font-size:0.76rem;font-weight:var(--w-semibold);letter-spacing:0.05em;text-transform:uppercase;color:var(--cm-text-strong);}
.workflow__step p{margin-top:0.4rem;font-size:0.82rem;line-height:1.45;color:var(--cm-text-muted);}
.workflow__arrow{color:var(--cm-silver);font-size:1.15rem;line-height:1;padding:0.35rem 0;text-align:center;transition:color var(--dur-3);}
.ocp-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,4vw,4rem);align-items:center;margin-top:1.5rem;}
@media(max-width:900px){.ocp-grid{grid-template-columns:1fr;}}
.mock{width:100%;background:var(--cm-ink-850);border:1px solid var(--cm-border-strong);border-radius:var(--r-md);overflow:hidden;box-shadow:var(--shadow-lg);font-size:0.78rem;}
.mock__bar{display:flex;align-items:center;gap:0.5rem;padding:0.7rem 0.9rem;border-bottom:1px solid var(--cm-border);background:var(--cm-ink-800);}
.mock__bar i{width:9px;height:9px;border-radius:50%;background:var(--cm-ink-500);display:block;}
.mock__bar span{margin-left:auto;font-family:var(--font-mono);font-size:0.66rem;color:var(--cm-text-subtle);}
.mock__body{padding:1rem;display:grid;grid-template-columns:0.8fr 1.2fr;gap:0.8rem;}
.mock__side{display:flex;flex-direction:column;gap:0.5rem;}
.mock__row{display:flex;align-items:center;gap:0.55rem;padding:0.5rem 0.6rem;border-radius:var(--r-sm);color:var(--cm-gray-300);font-size:0.74rem;}
.mock__row.active{background:var(--cm-surface-2);color:var(--cm-text-strong);}
.mock__row b{width:6px;height:6px;border-radius:50%;background:var(--cm-silver);display:block;}
.mock__main{display:flex;flex-direction:column;gap:0.6rem;}
.mock__card{background:var(--cm-ink-800);border:1px solid var(--cm-border);border-radius:var(--r-sm);padding:0.75rem;}
.mock__progress{height:5px;background:var(--cm-ink-600);border-radius:99px;margin-top:0.5rem;overflow:hidden;}
.mock__progress i{display:block;height:100%;background:var(--cm-silver);}
.mock__k{font-family:var(--font-mono);font-size:0.64rem;color:var(--cm-text-subtle);text-transform:uppercase;letter-spacing:0.06em;}
.mock__v{color:var(--cm-text-strong);font-weight:var(--w-semibold);margin-top:2px;}
</style>
</Fragment>

<main>
<section class="page-hero"><div class="container">
  <div class="page-hero__inner">
    <div>
      <span class="eyebrow">Services</span>
      <h1 class="display-lg measure">Full-service<br><em>physical model</em><br>making,<br>managed<br><em>end to end</em>.</h1>
      <p class="lead measure">Carve Model creates architectural models, product prototypes, film miniatures, and art maquettes for presentation, evaluation, testing, and physical verification.</p>
      <div class="hero__cta">
        <a class="btn btn--primary btn--lg" href="/contact">Get a Preliminary Estimate <span class="arrow">→</span></a>
        <a class="btn btn--ghost btn--lg" href="/works">View Our Work <span class="arrow">→</span></a>
      </div>
    </div>
    <div class="page-hero__visual reveal">
      <span class="corner tl"></span><span class="corner br"></span>
      <img class="hero-photo" src="/assets/service-hero.webp" alt="Carve Model architectural scale model" width="1080" height="810" fetchpriority="high" loading="eager" decoding="async">
      <span class="slot-label">Tech Campus · 1:200 · ABS</span>
      <div class="hero__spec">
        <span class="tick">PROJECTS DELIVERED</span>
        <strong>500+ models</strong>
      </div>
    </div>
  </div>
</div></section>

<section class="section section--tight"><div class="container">
  <span class="eyebrow reveal">Design realization &amp; physical verification</span>
  <h2 class="display-md reveal mt-3 measure">Start with what you have.</h2>
  <div class="dr-grid">
    <div>
      <p class="muted reveal">Projects may begin with CAD, BIM, 3D files, drawings, sketches, photographs, renderings, existing objects, or AI-generated reference images. When usable geometry is available, we prepare it for physical production as part of the model-making process.</p>
      <p class="muted reveal mt-3">When production-ready geometry does not exist, Digital Model Development may be separately scoped to create the geometry and production information required for the physical model.</p>
    </div>
    <div>
      <div class="workflow reveal">
        <div class="wf-branch">
          <div class="wf-path wf-path--left">
            <span class="wf-path__label">Path A</span>
            <div class="workflow__step">
              <h4>Production-ready 3D files</h4>
              <p>CAD, BIM or existing model</p>
            </div>
            <span class="workflow__arrow">↓</span>
          </div>
          <div class="wf-path wf-path--right">
            <span class="wf-path__label">Path B</span>
            <div class="workflow__step">
              <h4>Reference information only</h4>
              <p>Photo, sketch, rendering or AI image</p>
            </div>
            <span class="workflow__arrow">↓</span>
            <div class="workflow__step">
              <h4>Digital model development (separately scoped)</h4>
              <p>Create the required geometry</p>
            </div>
            <span class="workflow__arrow">↓</span>
          </div>
        </div>
        <span class="workflow__arrow">↓</span>
        <div class="workflow__step">
          <h4>Digital file preparation</h4>
          <p>Prepare geometry for fabrication</p>
        </div>
        <span class="workflow__arrow">↓</span>
        <div class="workflow__step">
          <h4>Samples and approvals</h4>
          <p>When required</p>
        </div>
        <span class="workflow__arrow">↓</span>
        <div class="workflow__step">
          <h4>Fabrication and quality control</h4>
        </div>
        <span class="workflow__arrow">↓</span>
        <div class="workflow__step">
          <h4>Physical model or prototype</h4>
        </div>
        <span class="workflow__arrow">↓</span>
        <div class="workflow__step">
          <h4>Communicate, evaluate, test or approve</h4>
        </div>
      </div>
    </div>
  </div>
</div></section>

<section class="section section--tight"><div class="container">
  <span class="eyebrow reveal">What we build</span>
  <h2 class="display-md reveal mt-3 measure">Physical models for the markets we serve.</h2>
  <p class="muted reveal mt-3 markets-line">Every project is developed around its audience, intended use, required level of detail, physical constraints, schedule, and delivery requirements.</p>
</div></section>

<div class="container">
  <article class="svc-block" id="architectural">
    <div>
      <span class="eyebrow">01 — Architecture</span>
      <h2>Architectural &amp; Real Estate Models</h2>
      <p>Models that help architects, developers, planning teams, and real estate professionals communicate designs, evaluate spatial relationships, support approvals, and present projects with confidence.</p>
      <p>From early massing studies to detailed sales-gallery models, each model is developed around the information its audience needs to understand.</p>
      <a class="svc-explore" href="/architectural-scale-models">Explore Architectural &amp; Real Estate Models <span class="arrow">→</span></a>
      <ul>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Massing and concept models</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Masterplan and urban-planning models</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Planning and design-review models</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Sales-gallery and presentation models</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Topographic and site models</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Existing-condition and as-built models</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Lighting, bases, display cases, delivery, and installation</li>
      </ul>
    </div>
    <div class="svc-block__media"><image-slot id="svc-arch" placeholder="Drop architectural model photo" src="/assets/service-architecture-hero.webp"></image-slot></div>
  </article>

  <article class="svc-block" id="product">
    <div>
      <span class="eyebrow">02 — Product</span>
      <h2>Product Prototypes &amp; Mockups</h2>
      <p>Physical prototypes that transform sketches, reference images, CAD files, and generated concepts into objects teams can present, evaluate, test, and refine before moving into production.</p>
      <a class="svc-explore" href="/scale-model-services/product">Explore Product Prototypes &amp; Mockups <span class="arrow">→</span></a>
      <ul>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Appearance and presentation prototypes</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Form and proportion studies</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Material and finish samples</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Functional and fabrication prototypes</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Assembly and connection mockups</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Investor and trade-show models</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Custom product-display models</li>
      </ul>
    </div>
    <div class="svc-block__media"><image-slot id="svc-product" placeholder="Drop product prototype photo" src="/assets/service-product-prototype-hero-v3.webp"></image-slot></div>
  </article>

  <article class="svc-block" id="film">
    <div>
      <span class="eyebrow">03 — Film</span>
      <h2>Film &amp; Commercial Miniatures</h2>
      <p>Miniature sets and physical models for art departments, directors, agencies, and production teams. Built to support previsualization, camera planning, composition, presentation, and production.</p>
      <a class="svc-explore" href="/scale-model-services/film">Explore Film &amp; Commercial Miniatures <span class="arrow">→</span></a>
      <ul>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Previsualization models</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Miniature sets</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Camera and composition studies</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Commercial product miniatures</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Lightweight, transport-ready construction</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Models designed for filming and repeated handling</li>
      </ul>
    </div>
    <div class="svc-block__media"><image-slot id="svc-film" placeholder="Drop film miniature photo" src="/assets/service-product-film-hero-v2.webp"></image-slot></div>
  </article>

  <article class="svc-block" id="art" style="border-bottom:0;">
    <div>
      <span class="eyebrow">04 — Art</span>
      <h2>Art Maquettes &amp; Prototypes</h2>
      <p>Physical maquettes and prototypes that help artists, designers, and cultural institutions evaluate scale, proportion, placement, materials, and fabrication direction before producing the final work.</p>
      <a class="svc-explore" href="/scale-model-services/art">Explore Art Maquettes &amp; Prototypes <span class="arrow">→</span></a>
      <ul>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Artist maquettes</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Sculpture scale studies</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Placement and context models</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Material and finish samples</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Fabrication and assembly prototypes</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Exhibition presentation models</li>
      </ul>
    </div>
    <div class="svc-block__media"><image-slot id="svc-art" placeholder="Drop art installation / sculpture photo" src="/assets/service-art-maquette-hero.webp"></image-slot></div>
  </article>
</div>

<section class="section section--tight"><div class="container">
  <span class="eyebrow reveal">One controlled process</span>
  <h2 class="display-md reveal mt-3 measure">From initial reference to coordinated delivery.</h2>
  <div class="ocp-grid">
    <div>
      <p class="muted reveal">Every project follows a structured process adapted to the physical deliverable. Depending on the scope, this can include goal definition, constraints, digital preparation, physical samples, approvals, fabrication, quality control, packaging, delivery, and setup.</p>
      <p class="muted reveal mt-3">The Carve Studio Portal makes the process visible by organizing milestones, files, approvals, messages, estimates, and project information in one shared workspace.</p>
      <div class="hero__cta reveal">
        <a class="btn btn--ghost" href="/model-making-process">Full Process <span class="arrow">→</span></a>
        <a class="btn btn--ghost" href="/login">See how Studio Portal works <span class="arrow">→</span></a>
      </div>
