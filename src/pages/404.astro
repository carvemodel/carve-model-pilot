---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page Not Found — Carve Model"
  description="The page you're looking for doesn't exist or has moved."
  canonicalPath="/404"
  ogTitle="Page Not Found — Carve Model"
  ogDescription="The page you're looking for doesn't exist or has moved."
  imageSlot={false}
  robotsNoIndex={true}
>
<Fragment slot="head">
<style>
.nf-wrap{padding-top:clamp(4rem,8vw,6rem);padding-bottom:clamp(4rem,8vw,6rem);text-align:center;}
.nf-card{max-width:560px;margin:0 auto;}
.nf-code{font-family:var(--font-mono);font-size:0.8rem;letter-spacing:0.08em;text-transform:uppercase;color:var(--cm-text-subtle);}
.nf-card h1{margin-top:1rem;}
.nf-card p{color:var(--cm-text-muted);margin-top:0.9rem;}
.nf-links{display:flex;gap:1rem;justify-content:center;margin-top:2.2rem;flex-wrap:wrap;}
</style>
</Fragment>

<main>
<section class="section nf-wrap"><div class="container">
  <div class="nf-card">
    <div class="nf-code">404</div>
    <h1 class="display-lg">We couldn't find that page.</h1>
    <p>It may have moved, or the link may be out of date. Here are a few places to pick back up.</p>
    <div class="nf-links">
      <a class="btn btn--primary" href="/scale-model-services">Services →</a>
      <a class="btn btn--ghost" href="/works">Works →</a>
      <a class="btn btn--ghost" href="/contact">Contact →</a>
    </div>
  </div>
</div></section>
</main>
</BaseLayout>
