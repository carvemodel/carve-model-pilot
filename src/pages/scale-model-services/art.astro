---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Art Maquettes & Prototypes | Carve Model"
  description="Art maquettes and prototypes for artists, designers, and cultural institutions — scale studies, placement models, and exhibition-ready pieces."
  canonicalPath="/scale-model-services/art"
  ogTitle="Art Maquettes & Prototypes | Carve Model"
  ogDescription="Art maquettes and prototypes for artists, designers, and cultural institutions — scale studies, placement models, and exhibition-ready pieces."
  active="services"
  imageSlot={true}
>
<Fragment slot="head">
<script type="application/ld+json" is:inline set:html={`{"@context":"https://schema.org","@type":"Service","serviceType":"Art Maquettes & Prototypes","provider":{"@type":"ProfessionalService","name":"Carve Model","areaServed":["United States","Canada"]}}`} />
<style>
.breadcrumb{padding-top:1.6rem;}
.breadcrumb a{font-family:var(--font-mono);font-size:0.78rem;letter-spacing:0.04em;color:var(--cm-text-subtle);transition:color var(--dur-2);}
.breadcrumb a:hover{color:var(--cm-text-strong);}
.page-hero{padding-top:1.6rem;padding-bottom:clamp(2.5rem,4vw,4rem);border-bottom:1px solid var(--cm-line-faint);}
.page-hero h1{margin-top:1.4rem;}
.page-hero h1 em{font-style:normal;color:var(--cm-text-muted);}
.page-hero p{margin-top:1.4rem;}
.page-hero__inner{display:grid;grid-template-columns:0.85fr 1.15fr;gap:clamp(1.5rem,3vw,3rem);align-items:center;}
@media(max-width:900px){.page-hero__inner{grid-template-columns:1fr;}.page-hero__visual{order:-1;max-width:440px;}}
.page-hero__visual{position:relative;}
.page-hero__visual image-slot{width:100%;height:auto;aspect-ratio:4/3;border-radius:var(--r-sm);}
.page-hero__visual .corner{position:absolute;width:14px;height:14px;border:1px solid var(--cm-silver);opacity:0.5;z-index:3;}
.page-hero__visual .corner.tl{top:-1px;left:-1px;border-right:0;border-bottom:0;}
.page-hero__visual .corner.br{bottom:-1px;right:-1px;border-left:0;border-top:0;}
.hero__spec{position:absolute;right:-12px;bottom:24px;z-index:4;background:var(--cm-ink-800);border:1px solid var(--cm-border-strong);padding:0.9rem 1.1rem;box-shadow:var(--shadow-lg);}
.hero__spec .tick{display:block;}
.hero__spec strong{font-family:var(--font-display);font-weight:var(--w-bold);color:var(--cm-text-strong);font-size:1.1rem;letter-spacing:-0.01em;}
.hero__cta{display:flex;gap:0.9rem;flex-wrap:nowrap;margin-top:1.8rem;}
@media(max-width:560px){.hero__cta{flex-wrap:wrap;}}
.hero__cta .btn--primary,.hero__cta .btn--ghost{background:transparent;color:var(--cm-text-strong);border:1px solid var(--cm-border-strong);}
.hero__cta .btn--primary:hover,.hero__cta .btn--ghost:hover{background:var(--cm-accent);color:var(--cm-accent-contrast);border-color:var(--cm-accent);}
.svc-all-btn{background:transparent;color:var(--cm-text-strong);}
.svc-all-btn:hover{background:var(--cm-accent);color:var(--cm-accent-contrast);border-color:var(--cm-accent);}
.svc-section{padding-block:clamp(3rem,5vw,5rem);border-bottom:1px solid var(--cm-line-faint);}
.svc-section h2{font-size:clamp(1.6rem,2.8vw,2.3rem);letter-spacing:-0.02em;margin-top:1rem;}
.svc-section .lead-p{margin-top:1.2rem;max-width:68ch;}
.svc-checklist{list-style:none;padding:0;margin:1.8rem 0 0;display:grid;gap:0.75rem;max-width:68ch;}
.svc-checklist li{display:flex;gap:0.7rem;align-items:flex-start;font-size:0.98rem;color:var(--cm-text-muted);}
.svc-checklist li svg{flex:none;margin-top:4px;color:var(--cm-silver);}
.svc-types{display:grid;grid-template-columns:repeat(2,1fr);gap:clamp(1.6rem,3vw,2.6rem);margin-top:2rem;}
.svc-type{padding-top:0;border-top:0;}
.svc-type__media{margin-bottom:0.9rem;}
.svc-type__media image-slot{width:100%;height:auto;aspect-ratio:4/3;border-radius:var(--r-sm);}
.svc-type h3{font-size:1.1rem;font-weight:var(--w-semibold);color:var(--cm-text-strong);letter-spacing:-0.01em;}
.svc-type p{margin-top:0.5rem;color:var(--cm-text-muted);font-size:0.92rem;max-width:none;}
@media(max-width:760px){.svc-types{grid-template-columns:1fr;}}
.svc-steps{display:grid;gap:0;margin-top:2rem;max-width:68ch;}
.svc-step{display:grid;grid-template-columns:2.4rem 1fr;gap:1rem;padding-block:1rem;border-bottom:1px solid var(--cm-line-faint);}
.svc-step:last-child{border-bottom:0;}
.svc-step__n{font-family:var(--font-mono);font-size:0.85rem;color:var(--cm-text-subtle);padding-top:0.15rem;}
.svc-step p{color:var(--cm-text-muted);font-size:0.95rem;}
.svc-note{margin-top:1.4rem;color:var(--cm-text-muted);max-width:68ch;}
.formats{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--cm-line-faint);border:1px solid var(--cm-line-faint);margin-top:1.8rem;}
.fmt{position:relative;background:var(--cm-ink-900);padding:1.4rem 1rem;text-align:center;font-family:var(--font-mono);font-size:0.8rem;color:var(--cm-gray-300);letter-spacing:0.03em;transition:background var(--dur-3),color var(--dur-3);}
.fmt:hover{background:var(--cm-ink-850);color:var(--cm-text-strong);}
@media(max-width:760px){.formats{grid-template-columns:repeat(2,1fr);}}
@media(max-width:480px){.formats{grid-template-columns:1fr;}}
.svc-split{display:grid;grid-template-columns:1.1fr 0.9fr;gap:clamp(2rem,4vw,4rem);align-items:start;}
.svc-split .svc-checklist,.svc-split .lead-p{max-width:none;}
.svc-split__media image-slot{width:100%;height:auto;aspect-ratio:4/5;border-radius:var(--r-sm);}
@media(max-width:900px){.svc-split{grid-template-columns:1fr;}.svc-split__media{order:-1;max-width:440px;}}
</style>
</Fragment>

<main>
<div class="container breadcrumb"><a href="/scale-model-services">← All services</a></div>

<section class="page-hero"><div class="container">
  <div class="page-hero__inner">
    <div>
      <span class="eyebrow">Services / Art</span>
      <h1 class="display-lg measure">Turn an artistic <em>concept</em><br>into a <em>physical</em><br>study.</h1>
      <p class="lead measure">Carve Model creates physical maquettes and fabrication prototypes for artists, designers, public-art teams, galleries, and cultural institutions.</p>
      <p class="muted measure">Our models help clients evaluate scale, proportion, placement, materials, assembly, and fabrication direction before committing to a final artwork or installation.</p>
      <div class="hero__cta">
        <a class="btn btn--primary btn--lg" href="/contact">Get a Preliminary Estimate <span class="arrow">→</span></a>
        <a class="btn btn--ghost btn--lg" href="/works">View Art Work <span class="arrow">→</span></a>
      </div>
    </div>
    <div class="page-hero__visual reveal">
      <span class="corner tl"></span><span class="corner br"></span>
      <image-slot id="svc-art-hero" placeholder="Drop art installation / sculpture photo" src="/assets/service-art-maquette-hero.webp"></image-slot>
      <div class="hero__spec">
        <span class="tick">PROJECTS DELIVERED</span>
        <strong>500+ models</strong>
      </div>
    </div>
  </div>
</div></section>

<section class="svc-section"><div class="container">
  <span class="eyebrow">Why build a maquette?</span>
  <h2>Study the work before producing it at full scale.</h2>
  <div class="svc-split" style="margin-top:1.2rem;">
    <div>
      <p class="lead-p muted" style="margin-top:0;">A maquette brings an artistic concept into physical space at a manageable size. It allows the artist, client, fabricator, institution, or approval committee to examine the work from multiple viewpoints and understand its relationship to a site.</p>
      <p class="muted" style="margin-top:1rem;">Depending on the project, a maquette can help:</p>
      <ul class="svc-checklist">
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Evaluate form and proportion</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Study scale relative to people or architecture</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Review placement and site relationships</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Compare material and finish directions</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Communicate the concept to stakeholders</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Support fundraising, selection, or approval</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Explore assembly and fabrication approaches</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Create a presentation or exhibition object</li>
      </ul>
    </div>
    <div class="svc-split__media"><image-slot id="svc-art-why" placeholder="Drop a project photo"></image-slot></div>
  </div>
</div></section>

<section class="svc-section"><div class="container">
  <div class="flex justify-between items-center wrap gap">
    <div>
      <span class="eyebrow">Maquette and prototype types</span>
      <h2>Physical studies for artistic development and approval.</h2>
    </div>
    <a class="btn btn--ghost svc-all-btn" href="/works">View Our Work <span class="arrow">→</span></a>
  </div>
  <div class="svc-types">
    <div class="svc-type"><div class="svc-type__media"><image-slot id="svc-atype-artist" placeholder="Drop artist maquette photo"></image-slot></div><h3>Artist maquettes</h3><p>Reduced-scale physical interpretations of an artwork used to study form, balance, composition, and visual intent.</p></div>
    <div class="svc-type"><div class="svc-type__media"><image-slot id="svc-atype-scale" placeholder="Drop sculpture scale study photo"></image-slot></div><h3>Sculpture scale studies</h3><p>Models used to evaluate how an artwork's proportions change when translated to a proposed final size.</p></div>
    <div class="svc-type"><div class="svc-type__media"><image-slot id="svc-atype-placement" placeholder="Drop placement/context model photo"></image-slot></div><h3>Placement and context models</h3><p>Maquettes shown within a representation of the surrounding site, landscape, architecture, or public space.</p></div>
    <div class="svc-type"><div class="svc-type__media"><image-slot id="svc-atype-material" placeholder="Drop material/finish sample photo"></image-slot></div><h3>Material and finish samples</h3><p>Physical studies used to compare colors, textures, reflectivity, transparency, coatings, surface treatments, and material transitions.</p></div>
    <div class="svc-type"><div class="svc-type__media"><image-slot id="svc-atype-fabrication" placeholder="Drop fabrication/assembly prototype photo"></image-slot></div><h3>Fabrication and assembly prototypes</h3><p>Models focused on selected components, connections, modules, joints, or production approaches that require physical evaluation.</p></div>
    <div class="svc-type"><div class="svc-type__media"><image-slot id="svc-atype-presentation" placeholder="Drop presentation model photo"></image-slot></div><h3>Presentation models</h3><p>Refined maquettes developed for commissions, selection panels, fundraising, client presentations, exhibitions, and institutional approvals.</p></div>
  </div>
</div></section>

<section class="svc-section"><div class="container">
  <span class="eyebrow">From image to physical form</span>
  <h2>Resolving what the reference does not show.</h2>
  <p class="muted" style="margin-top:1rem;">Art projects may begin with:</p>
  <div class="formats">
    <div class="fmt">Sketches</div>
    <div class="fmt">Drawings</div>
    <div class="fmt">Photographs</div>
    <div class="fmt">Renderings</div>
    <div class="fmt">CAD or 3D models</div>
    <div class="fmt">Existing objects</div>
    <div class="fmt">Material references</div>
    <div class="fmt">Hand-built studies</div>
    <div class="fmt">AI-generated images</div>
  </div>
  <p class="svc-note" style="max-width:none;">A visual reference may communicate the artistic direction without defining every surface, dimension, connection, or assembly decision.</p>
  <p class="svc-note" style="max-width:none;">* When usable geometry does not exist, Digital Model Development may be separately scoped. Carve develops a reviewable physical interpretation based on the supplied references and decisions made with the client.</p>
  <p class="svc-note" style="max-width:none;">The objective is not to guess the artist's intent. It is to identify ambiguities, develop the required geometry, and obtain approval before fabrication.</p>
</div></section>

<section class="svc-section"><div class="container">
  <span class="eyebrow">Defining the study</span>
  <h2>Build what the project needs to evaluate.</h2>
  <div class="svc-split" style="margin-top:1.2rem;">
    <div>
      <p class="muted" style="margin-top:0;">Before production, we establish:</p>
      <ul class="svc-checklist">
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Purpose of the maquette or prototype</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Intended audience</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Proposed final dimensions</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Maquette scale or physical size</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Important viewpoints</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Required site context</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Materials and finish direction</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Areas requiring greater accuracy</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Elements that can be simplified</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Removable or interchangeable components</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Presentation, transport, and display requirements</li>
        <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Approval schedule and delivery location</li>
      </ul>
      <p class="svc-note">The physical study should focus on the aspects of the work that require examination or communication.</p>
    </div>
    <div class="svc-split__media"><image-slot id="svc-art-define" placeholder="Drop a project photo"></image-slot></div>
  </div>
</div></section>

<section class="svc-section"><div class="container">
  <span class="eyebrow">What the maquette does not claim</span>
  <h2>A physical study is not the final artwork.</h2>
  <p class="lead-p muted">Unless specifically defined otherwise, an art maquette or prototype does not certify the engineering, structural performance, public safety, code compliance, durability, or full-scale fabrication feasibility of the completed artwork.</p>
  <p class="muted" style="margin-top:1rem;max-width:68ch;">Its role is to support artistic development, communication, selected physical evaluation, and approval. Full-scale engineering and fabrication should be coordinated separately with the appropriate specialists.</p>
</div></section>

<section class="svc-section"><div class="container">
  <span class="eyebrow">Materials and methods</span>
  <h2>Depending on the project, a maquette may combine:</h2>
  <ul class="svc-checklist">
    <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Resin and 3D-printed components</li>
    <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Acrylic and plastics</li>
    <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Wood and engineered board</li>
    <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Foam and sculptural materials</li>
    <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Metal components</li>
    <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> CNC machining and laser cutting</li>
    <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Painting and custom finishes</li>
    <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Transparent or illuminated elements</li>
    <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Context bases and landscape</li>
    <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Removable or interchangeable components</li>
    <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Skilled hand assembly and finishing</li>
  </ul>
  <p class="svc-note">Materials are selected according to what the maquette needs to represent, how it will be handled, and how closely it should approximate the proposed artwork.</p>
</div></section>

<section class="svc-section" style="border-bottom:0;"><div class="container">
  <div class="flex justify-between items-center wrap gap">
    <div>
      <span class="eyebrow">How it works</span>
      <h2>From artistic reference to approved physical study.</h2>
    </div>
    <a class="btn btn--ghost svc-all-btn" href="/model-making-process">View Our Process <span class="arrow">→</span></a>
  </div>
  <div class="svc-steps">
    <div class="svc-step"><span class="svc-step__n">01</span><p>Define the purpose, audience, and required evaluation</p></div>
    <div class="svc-step"><span class="svc-step__n">02</span><p>Review the concept, dimensions, site, and reference material</p></div>
    <div class="svc-step"><span class="svc-step__n">03</span><p>Develop or prepare the required geometry</p></div>
    <div class="svc-step"><span class="svc-step__n">04</span><p>Review interpreted forms and important design decisions</p></div>
    <div class="svc-step"><span class="svc-step__n">05</span><p>Produce samples or partial mockups when useful</p></div>
    <div class="svc-step"><span class="svc-step__n">06</span><p>Fabricate, assemble, and finish the maquette</p></div>
    <div class="svc-step"><span class="svc-step__n">07</span><p>Inspect, package, and deliver the completed work</p></div>
  </div>
  <a class="svc-explore" href="/model-making-process" style="display:inline-flex;align-items:center;gap:0.5rem;margin-top:1.4rem;font-family:var(--font-mono);font-size:0.82rem;letter-spacing:0.03em;color:var(--cm-text-strong);border-bottom:1px solid var(--cm-border-strong);padding-bottom:2px;">View Our Process <span class="arrow">→</span></a>
</div></section>

<section class="section"><div class="container">
  <div class="cta reveal" style="position:relative;text-align:center;background:var(--cm-black);border:1px solid var(--cm-border);border-radius:var(--r-sm);padding:clamp(3rem,6vw,5rem) var(--gutter);">
    <h2 class="display-md">Start an art maquette or prototype project.</h2>
    <p class="muted mt-2" style="max-width:52ch;margin-inline:auto;">Tell us what you are developing, what the physical study needs to communicate or evaluate, and what reference material is currently available. We will recommend an appropriate scale, scope, and production approach.</p>
    <div class="hero__cta" style="justify-content:center;margin-top:2.4rem;">
      <a class="btn btn--primary btn--lg" href="/contact">Get a Preliminary Estimate <span class="arrow">→</span></a>
      <a class="btn btn--ghost btn--lg" href="/scale-model-services">All services <span class="arrow">→</span></a>
    </div>
  </div>
</div></section>
</main>
</BaseLayout>
