---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Art Maquettes & Prototypes | Carve Model"
  description="Art maquettes and prototypes for artists, designers, and cultural institutions — scale studies, placement models, and exhibition-ready pieces."
  canonicalPath="/scale-model-services/art"
  ogTitle="Art Maquettes & Prototypes | Carve Model"
  ogDescription="Art maquettes and prototypes for artists, designers, and cultural institutions — scale studies, placement models, and exhibition-ready pieces."
  active="services"
  imageSlot={true}
>
<Fragment slot="head">
<script type="application/ld+json" is:inline set:html={`{"@context":"https://schema.org","@type":"Service","serviceType":"Art Maquettes & Prototypes","provider":{"@type":"ProfessionalService","name":"Carve Model","areaServed":["United States","Canada"]}}`} />
<style>
.breadcrumb{padding-top:1.6rem;}
.breadcrumb a{font-family:var(--font-mono);font-size:0.78rem;letter-spacing:0.04em;color:var(--cm-text-subtle);transition:color var(--dur-2);}
.breadcrumb a:hover{color:var(--cm-text-strong);}
.page-hero{padding-top:1.6rem;padding-bottom:clamp(2.5rem,4vw,4rem);border-bottom:1px solid var(--cm-line-faint);}
.page-hero h1{margin-top:1.4rem;}
.page-hero p{margin-top:1.4rem;}
.dedi-media{margin-top:clamp(2rem,4vw,3rem);}
.dedi-media image-slot{width:100%;height:auto;aspect-ratio:21/9;}
.dedi-body{padding-block:clamp(3rem,5vw,5rem);}
.dedi-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,4vw,4rem);align-items:start;}
.dedi-grid h2{font-size:clamp(1.6rem,2.6vw,2.1rem);letter-spacing:-0.02em;}
.dedi-list{list-style:none;padding:0;margin:1.4rem 0 0;display:grid;gap:0.8rem;}
.dedi-list li{display:flex;gap:0.7rem;align-items:flex-start;font-size:0.98rem;color:var(--cm-text-muted);}
.dedi-list li svg{flex:none;margin-top:4px;color:var(--cm-silver);}
@media(max-width:820px){.dedi-grid{grid-template-columns:1fr;}}
</style>
</Fragment>

<main>
<div class="container breadcrumb"><a href="/scale-model-services">← All services</a></div>

<section class="page-hero"><div class="container">
  <span class="eyebrow">Services / Art</span>
  <h1 class="display-lg measure">Art Maquettes &amp; Prototypes</h1>
  <p class="lead measure">Physical maquettes and prototypes that help artists, designers, and cultural institutions evaluate scale, proportion, placement, materials, and fabrication direction before producing the final work.</p>
  <div class="dedi-media"><image-slot id="svc-art-hero" placeholder="Drop art installation / sculpture photo" src="/assets/service-art-maquette-hero.webp"></image-slot></div>
</div></section>

<section class="dedi-body"><div class="container">
  <div class="dedi-grid">
    <div>
      <span class="eyebrow reveal">What's included</span>
      <h2 class="reveal mt-3">From maquette to exhibition-ready piece.</h2>
    </div>
    <ul class="dedi-list reveal">
      <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Artist maquettes</li>
      <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Sculpture scale studies</li>
      <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Placement and context models</li>
      <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Material and finish samples</li>
      <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Fabrication and assembly prototypes</li>
      <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Exhibition presentation models</li>
    </ul>
  </div>
</div></section>

<section class="section"><div class="container">
  <div class="cta reveal" style="position:relative;text-align:center;background:var(--cm-black);border:1px solid var(--cm-border);border-radius:var(--r-sm);padding:clamp(3rem,6vw,5rem) var(--gutter);">
    <h2 class="display-md">Start an art maquette project.</h2>
    <p class="muted mt-2" style="max-width:46ch;margin-inline:auto;">Tell us about your project and we'll recommend the right scope and scale.</p>
    <div class="mt-4" style="display:flex;gap:0.9rem;justify-content:center;flex-wrap:wrap;">
      <a class="btn btn--primary btn--lg" href="/contact">Get a Preliminary Estimate <span class="arrow">→</span></a>
      <a class="btn btn--ghost btn--lg" href="/scale-model-services">All services <span class="arrow">→</span></a>
    </div>
  </div>
</div></section>
</main>
</BaseLayout>
