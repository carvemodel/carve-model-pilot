<script is:inline>
(function(){
  var sc=document.getElementById('csScroll'),p=document.getElementById('csPrev'),n=document.getElementById('csNext');
  if(!sc||!p||!n)return;
  function step(d){var card=sc.querySelector('.cs-card');var w=card?card.getBoundingClientRect().width+24:400;sc.scrollBy({left:d*w,behavior:'smooth'});}
  function upd(){var max=sc.scrollWidth-sc.clientWidth;var many=max>4;p.parentElement.style.display=many?'flex':'none';p.disabled=sc.scrollLeft<=2;n.disabled=sc.scrollLeft>=max-2;p.style.opacity=p.disabled?0.4:1;n.style.opacity=n.disabled?0.4:1;}
  p.addEventListener('click',function(){step(-1);});n.addEventListener('click',function(){step(1);});
  sc.addEventListener('scroll',upd,{passive:true});window.addEventListener('resize',upd);upd();
})();
</script>
